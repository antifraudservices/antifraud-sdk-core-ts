{
  "name": "antifraud-sdk-core-ts",
  "version": "0.1.3",
  "description": "Runtime-neutral orchestration for identity verification and provider-issued credentials",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antifraudservices/antifraud-sdk-core-ts.git"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "antifraud-data-utils-ts": "0.1.7"
  }
}
